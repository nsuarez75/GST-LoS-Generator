<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GstLosGenerator.App.ViewModels"
             xmlns:v="using:GstLosGenerator.App.Views"
             xmlns:c="using:GstLosGenerator.App.Controls"
             xmlns:l="using:GstLosGenerator.App"
             x:Class="GstLosGenerator.App.Views.AssetsView"
             x:DataType="vm:AssetsViewModel">
    <!-- Las columnas de la derecha tienen ancho fijo (así cuadran a cualquier profundidad del árbol)
         y se estrechan cuando la vista es estrecha (clase narrow, ver el código de la vista) -->
    <UserControl.Styles>
        <Style Selector=":is(Control).colType">
            <Setter Property="Width" Value="220" />
        </Style>
        <Style Selector=":is(Control).colOp">
            <Setter Property="Width" Value="150" />
        </Style>
        <Style Selector=":is(Control).colState">
            <Setter Property="Width" Value="210" />
        </Style>
        <Style Selector="v|AssetsView.narrow :is(Control).colType">
            <Setter Property="Width" Value="160" />
        </Style>
        <Style Selector="v|AssetsView.narrow :is(Control).colOp">
            <Setter Property="Width" Value="105" />
        </Style>
        <Style Selector="v|AssetsView.narrow :is(Control).colState">
            <Setter Property="Width" Value="150" />
        </Style>
        <!-- Variable desactivada: la fila atenuada, salvo su casilla -->
        <Style Selector="Grid.off > :is(Control):not(CheckBox)">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24,20,24,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="{l:T 'Assets'}" />
                <Border Classes="pill">
                    <TextBlock Text="{Binding Summary}" />
                </Border>
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding AddAssetCommand}" ToolTip.Tip="{l:T 'Añadir asset…'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="plus" />
                        <TextBlock Text="{l:T 'Añadir asset…'}" Classes="barlabel" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddVariableCommand}" ToolTip.Tip="{l:T 'Añadir variable'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="list-plus" />
                        <TextBlock Text="{l:T 'Añadir variable'}" Classes="barlabel" />
                    </StackPanel>
                </Button>
                <Button Classes="danger" Click="OnRemove" ToolTip.Tip="{l:T 'Eliminar'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="trash" />
                        <TextBlock Text="{l:T 'Eliminar'}" Classes="barlabel" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="520" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search}" PlaceholderText="{l:T 'Buscar asset, tipo, variable o dirección'}">
                    <TextBox.InnerLeftContent>
                        <c:Icon Kind="search" Width="14" Height="14" Margin="10,0,0,0" Foreground="{DynamicResource App.TextMuted}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Classes="ghost" Command="{Binding ExpandAllCommand}" ToolTip.Tip="{l:T 'Expandir'}">
                        <c:Icon Kind="expand" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding CollapseAllCommand}" ToolTip.Tip="{l:T 'Contraer'}">
                        <c:Icon Kind="collapse" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Classes="card" Padding="0">
            <DockPanel>
                <!-- Cabecera de columnas de los assets -->
                <Border DockPanel.Dock="Top" Classes="tablehead" Padding="46,10,9,8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBlock Classes="columnHeader" Text="{l:T 'ASSET · VARIABLE'}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="columnHeader colType" Margin="0,0,8,0" Text="{l:T 'TIPO · DATO'}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="columnHeader colOp" Margin="0,0,8,0" Text="{l:T 'OPERACIÓN · SENTIDO'}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Classes="columnHeader colState" Text="{l:T 'ESTADO · DIRECCIÓN'}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Varias variables se seleccionan con Mayús+clic o Ctrl+clic; se arrastran a otro asset por su asa -->
                <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}" SelectionMode="Multiple"
                          Margin="4,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="vm:AssetNodeViewModel" ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="22,*,Auto,Auto,Auto" Height="32" Classes.droptarget="{Binding IsDropTarget}">
                                <TextBlock Classes="label" Text="{Binding KindGlyph}" />
                                <TextBlock Grid.Column="1" Text="{Binding Element}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Element}" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="2" Classes="colType" ItemsSource="{Binding TypeNames}" SelectedItem="{Binding Type}" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="3" Classes="colOp" ItemsSource="{Binding OperationChoices}" SelectedItem="{Binding Operation}" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="4" Classes="badge colState" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
                            </Grid>
                        </TreeDataTemplate>
                        <DataTemplate DataType="vm:VariableRowViewModel">
                            <Grid ColumnDefinitions="22,*,Auto,Auto,Auto" Height="30" Classes.off="{Binding !Enabled}">
                                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                          ToolTip.Tip="{l:T 'Sin marcar, la señal está desactivada: en Struct TO DEVICE se escribe comentada.'}" />
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,8,0">
                                    <Border Classes="grip" Background="Transparent" Cursor="SizeAll" Padding="0,0,4,0" VerticalAlignment="Stretch"
                                            ToolTip.Tip="{l:T 'Arrastra la variable a otro asset para moverla.'}">
                                        <c:Icon Kind="grip" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMuted}" />
                                    </Border>
                                    <TextBox Classes="cell" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{Binding Description}" />
                                </Grid>
                                <TextBox Classes="cell colType" Grid.Column="2" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="3" Classes="colOp" ItemsSource="{x:Static vm:VariableRowViewModel.Directions}" SelectedItem="{Binding Direction}" Margin="0,0,8,0" />
                                <TextBox Classes="cell mono colState" Grid.Column="4" Text="{Binding Address, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:AssetNodeViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                </TreeView>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
