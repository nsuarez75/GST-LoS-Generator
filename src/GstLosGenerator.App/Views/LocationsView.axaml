<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GstLosGenerator.App.ViewModels"
             xmlns:l="using:GstLosGenerator.App"
             x:Class="GstLosGenerator.App.Views.LocationsView"
             x:DataType="vm:LocationsViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <DockPanel>
                <TextBlock Classes="h2" Text="{l:T 'Locations'}" VerticalAlignment="Center" />
                <StackPanel Classes="buttons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{l:T 'Añadir'}" Command="{Binding AddCommand}" />
                    <Button Content="{l:T 'Eliminar'}" Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="16,12"
                   Text="{l:T 'Cada location tiene un nombre (el que sale en el título de la operación) y un número (el que se escribe en Loc). Se definen una vez por PLC y se usan en varias operaciones.'}" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="300,120,*" Margin="28,4,16,4">
            <TextBlock Classes="columnHeader" Text="{l:T 'Nombre'}" />
            <TextBlock Grid.Column="1" Classes="columnHeader" Text="{l:T 'Número'}" />
            <TextBlock Grid.Column="2" Classes="columnHeader" Text="{l:T 'Usada en operaciones'}" />
        </Grid>
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Margin="8,0,8,8">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocationRowViewModel">
                    <Grid ColumnDefinitions="300,120,*">
                        <TextBox Classes="cell mono" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0" />
                        <TextBox Classes="cell" Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding UsedBy}" Classes="label" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
