<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GstLosGenerator.App.ViewModels"
             xmlns:c="using:GstLosGenerator.App.Controls"
             xmlns:l="using:GstLosGenerator.App"
             x:Class="GstLosGenerator.App.Views.PlcEditorView"
             x:DataType="vm:PlcEditorViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20" Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource App.AccentSoft}">
                        <c:Icon Kind="cpu" Width="20" Height="20" Foreground="{DynamicResource App.Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="{Binding Name}" />
                        <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ReadFbCommand}" ToolTip.Tip="{l:T 'Leer FB LoS…'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="file-code" />
                            <TextBlock Text="{l:T 'Leer FB LoS…'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="accent" Command="{Binding GenerateCommand}" ToolTip.Tip="{l:T 'Generar FB y UDT…'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="zap" />
                            <TextBlock Text="{l:T 'Generar FB y UDT…'}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="14">
                    <TextBlock Classes="label" Text="{l:T 'Nombre (como en la LoS)'}" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="240" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="1" Classes="label" Text="{l:T 'Número'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="2" Classes="label" Text="{l:T 'Devices'}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceNames}" VerticalAlignment="Center" Classes="mono" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Classes="label" Text="{l:T 'FB actual'}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentFb}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="3" Grid.Column="2" Classes="ghost danger" Command="{Binding ForgetFbCommand}" IsVisible="{Binding HasCurrentFb}" ToolTip.Tip="{l:T 'Olvidar'}">
                        <c:Icon Kind="x" />
                    </Button>
                </Grid>
            </Border>

            <Border Classes="tip">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <c:Icon Kind="info" Foreground="{DynamicResource App.AccentText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource App.AccentText}"
                               Text="{l:T 'El FB actual es el último leído con «Leer FB LoS». Al generar, se parte de él: lo que falta se añade y solo se reescribe lo que marques. Sin FB actual, el FB se genera desde cero.'}" />
                </Grid>
            </Border>

            <Button Classes="danger" HorizontalAlignment="Left" Command="{Binding RemoveCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="trash" />
                    <TextBlock Text="{l:T 'Quitar este PLC del proyecto…'}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
