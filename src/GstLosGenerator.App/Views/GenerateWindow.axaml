<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GstLosGenerator.App.ViewModels"
        xmlns:core="using:GstLosGenerator.Core"
        xmlns:c="using:GstLosGenerator.App.Controls"
        xmlns:l="using:GstLosGenerator.App"
        x:Class="GstLosGenerator.App.Views.GenerateWindow"
        Icon="/Assets/gst-los-generator.png"
        x:DataType="vm:GenerateViewModel"
        Title="{l:T 'Generar FB y UDT'}"
        Width="1040" Height="760" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="brand">
                    <c:Icon Kind="zap" Width="17" Height="17" Foreground="White" StrokeWidth="2.4" />
                </Border>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Plcs}" SelectedItem="{Binding Plc}" MinWidth="140" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:Plc">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="{l:T 'FB ACTUAL'}" />
                    <TextBlock Text="{Binding CurrentFb}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentFb}" />
                </StackPanel>
                <Button Grid.Column="3" Command="{Binding ReadFbCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="file-code" />
                        <TextBlock Text="{l:T 'Leer FB…'}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <TextBlock Classes="label" Text="{l:T 'Carpeta de salida'}" />
                <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" Classes="mono" />
                <Button Grid.Column="2" Command="{Binding PickFolderCommand}" ToolTip.Tip="{l:T 'Elegir…'}">
                    <c:Icon Kind="folder" />
                </Button>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{l:T 'Cerrar'}" Click="OnClose" IsCancel="True" />
                    <Button Classes="accent" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}" IsDefault="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="zap" />
                            <TextBlock Text="{l:T 'Generar'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="3*,2*">
            <!-- Assets -->
            <DockPanel Margin="20,16,10,16">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                    <TextBlock Classes="h2" Text="{l:T 'Assets que se reescriben'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="{l:T 'Todos'}" Command="{Binding MarkAllCommand}" />
                        <Button Content="{l:T 'Ninguno'}" Command="{Binding MarkNoneCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="0,0,0,10"
                           Text="{l:T 'Lo que falta en el FB actual se añade siempre. De lo que ya está, solo se reescriben las partes marcadas a la derecha de los assets marcados aquí; lo programado a mano se conserva.'}" />
                <Border Classes="card" Padding="4">
                    <ListBox ItemsSource="{Binding Assets}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GenerateAssetViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="{Binding Indent}">
                                    <CheckBox IsChecked="{Binding IsChecked}">
                                        <!-- Como texto, para que los _ del nombre no se tomen como atajos de teclado -->
                                        <TextBlock Text="{Binding Element}" />
                                    </CheckBox>
                                    <TextBlock Text="{Binding Note}" Classes="label" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Partes y avisos -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,16,20,16" Spacing="14">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="caption" Text="{l:T 'PARTES QUE SE REESCRIBEN'}" />
                            <CheckBox Content="{l:T 'Declaraciones de la estática'}" IsChecked="{Binding Static}" />
                            <CheckBox Content="{l:T 'Segmentos de operaciones'}" IsChecked="{Binding Operations}" />
                            <CheckBox Content="{l:T 'Llamadas a los assets'}" IsChecked="{Binding Calls}" />
                            <CheckBox Content="{l:T 'Struct TO DEVICE'}" IsChecked="{Binding Struct}" />
                            <CheckBox Content="{l:T 'Swaps (Float y enteros)'}" IsChecked="{Binding Swaps}" />
                            <Border Classes="divider" Margin="0,4" />
                            <CheckBox Content="{l:T 'Escribir los UDT de los devices'}" IsChecked="{Binding Udts}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{l:T 'AVISOS'}" />
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                                            <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Warn}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
