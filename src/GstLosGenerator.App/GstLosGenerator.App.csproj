<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GstLosGenerator</AssemblyName>
    <RootNamespace>GstLosGenerator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gst-los-generator.ico</ApplicationIcon>
    <Version>0.6.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GstLosGenerator.Core/GstLosGenerator.Core.csproj" />
    <InternalsVisibleTo Include="GstLosGenerator.App.Tests" />
  </ItemGroup>

  <!-- El puente con TIA (.NET Framework 4.8) va dentro del ejecutable de Windows; la app lo saca a disco y lo lanza.
       Fuera de Windows no se compila (necesita TIA Portal V19 instalado) y la app trabaja solo con archivos. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="../GstLosGenerator.Tia/GstLosGenerator.Tia.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net48" />
    <EmbeddedResource Include="../GstLosGenerator.Tia/bin/$(Configuration)/net48/GstLosGenerator.Tia.exe" LogicalName="GstLosGenerator.Tia.exe" />
  </ItemGroup>

</Project>
