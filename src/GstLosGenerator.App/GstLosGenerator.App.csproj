<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GstLosGenerator</AssemblyName>
    <RootNamespace>GstLosGenerator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gst-los-generator.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GstLosGenerator.Core/GstLosGenerator.Core.csproj" />
    <InternalsVisibleTo Include="GstLosGenerator.App.Tests" />
  </ItemGroup>

  <!-- TIA-Connector (submódulo en external/): todo lo que se hace con TIA pasa por su cliente, que lleva dentro el
       puente (un .exe .NET Framework 4.8 aparte, el único que carga Openness). Compilar necesita TIA Portal V19 -->
  <ItemGroup>
    <ProjectReference Include="../../external/TIA-Connector/src/TiaConnector.Client/TiaConnector.Client.csproj" />
  </ItemGroup>

</Project>
