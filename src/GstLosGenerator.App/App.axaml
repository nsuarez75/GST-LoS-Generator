<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GstLosGenerator.App.ViewModels"
             xmlns:v="using:GstLosGenerator.App.Views"
             x:Class="GstLosGenerator.App.App"
             RequestedThemeVariant="Default">

    <!-- Cada editor del panel central según su modelo de vista -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:ProjectEditorViewModel"><v:ProjectEditorView /></DataTemplate>
        <DataTemplate DataType="vm:PlcEditorViewModel"><v:PlcEditorView /></DataTemplate>
        <DataTemplate DataType="vm:DevicesViewModel"><v:DevicesView /></DataTemplate>
        <DataTemplate DataType="vm:AssetsViewModel"><v:AssetsView /></DataTemplate>
        <DataTemplate DataType="vm:OperationsViewModel"><v:OperationsView /></DataTemplate>
        <DataTemplate DataType="vm:LocationsViewModel"><v:LocationsView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />

        <Style Selector="Window">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Textos -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.badge">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Listas sin fondo propio -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Celdas editables de las tablas: sin marco hasta pasar por encima o editarlas -->
        <Style Selector="TextBox.cell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>

        <!-- Paneles y barras -->
        <Style Selector="Border.toolbar">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="StackPanel.buttons > Button, StackPanel.buttons > ToggleButton">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
